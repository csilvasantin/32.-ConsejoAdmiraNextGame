# Cloudflare Pages — cabeceras de www.admira.live
# El bar de navegación compartido (admira-bar.js) y sus assets iteran a menudo. Con la caché
# por defecto (4h) las mejoras (p.ej. la cuadratura) tardaban en verse. Caché corta + revalidar
# para que propaguen en minutos, no en horas.
/admira-bar.js
  Cache-Control: public, max-age=300, must-revalidate

/13rue/casa-nav.css
  Cache-Control: public, max-age=300, must-revalidate

/control/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/tester/*
  Cache-Control: no-store
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
